# Core app settings (required)
SECRET_KEY=change-me-to-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key

# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=true
LOAD_DOTENV=true
SKIP_NLTK_DOWNLOAD=false

# Database (default local setup)
DB_TYPE=sqlite
SQLITE_URI=sqlite:///instance/naic.db

# Optional impact-score tuning
IMPACT_BASE_LOAD=10
IMPACT_EXTERNAL_WEIGHT_FACTOR=1.0
IMPACT_BODYWEIGHT_FACTOR=0.25
IMPACT_MIN_EFFECTIVE_LOAD=0.0
